  "title": "Prevent guest checkout account adoption and duplicate evidence contacts",
  "user": {
    "login": "diegueins680",
    "id": 2753581,
    "node_id": "MDQ6VXNlcjI3NTM1ODE=",
    "avatar_url": "https://avatars.githubusercontent.com/u/2753581?v=4",
