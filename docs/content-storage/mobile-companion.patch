@@ -0,0 +1,46 @@
+import { uploadMedia } from '../src/api/upload';
+
+jest.mock('expo-crypto', () => ({ CryptoDigestAlgorithm: { SHA256: 'SHA-256' }, randomUUID: () => 'synthetic-upload-id', digestStringAsync: async () => 'a'.repeat(64) }));
+jest.mock('../src/lib/api', () => ({ API_BASE: 'https://api.tdf.test', UPLOAD_BASE: 'https://api.tdf.test/drive/upload' }));
+jest.mock('../src/api/client', () => ({
+  getAuthToken: () => 'Bearer synthetic-user',
+  captureAuthSession: () => ({ authorization: 'Bearer synthetic-user', signal: new AbortController().signal, version: 1 }),
+  assertAuthSession: jest.fn(),
+}));
+
+const fetchMock = jest.fn();
+beforeEach(() => { global.fetch = fetchMock; fetchMock.mockReset(); });
+const image = { uri: 'file:///synthetic-cover.png', mimeType: 'image/png', fileName: 'cover.png' };
+
+it('uses the actual DriveUploadDTO response and resolves private managed URLs against the API', async () => {
+  fetchMock.mockResolvedValue({ ok: true, json: async () => ({ duFileId: 'synthetic', duPublicUrl: null, duWebContentLink: '/storage/files/synthetic' }) });
+  await expect(uploadMedia({ ...image, destination: 'tdf' })).resolves.toBe('https://api.tdf.test/storage/files/synthetic');
+  expect(fetchMock).toHaveBeenCalledTimes(1);
+  const options = fetchMock.mock.calls[0][1];
+  expect(options.headers.Authorization).toBe('Bearer synthetic-user');
+  expect(options.body.get('destination')).toBe('tdf');
+  expect(options.body.get('authMode')).toBe('server');
+  expect(options.body.get('idempotencyKey')).toBe('a'.repeat(64));
+});
+it('never replaces missing personal authorization with a shared-account upload', async () => {
+  await expect(uploadMedia({ ...image, destination: 'google_drive' })).rejects.toMatchObject({ code: 'storage_reconnect_required' });
+  expect(fetchMock).not.toHaveBeenCalled();
+});
+it('retains the retry identity and keeps provider internals out of the error', async () => {
+  fetchMock.mockResolvedValue({ ok: false, json: async () => ({ code: 'storage_service_unavailable', message: 'synthetic-secret' }) });
+  const request = uploadMedia({ ...image, destination: 'tdf', idempotencyKey: 'b'.repeat(64) });
+  await expect(request).rejects.toMatchObject({ idempotencyKey: 'b'.repeat(64), code: 'storage_service_unavailable' });
+  await expect(request).rejects.not.toThrow('synthetic-secret');
+});
+it('requires an explicit or previously saved destination before sending bytes', async () => {
+  fetchMock.mockResolvedValue({ ok: true, json: async () => ({ defaultDestination: null }) });
+  await expect(uploadMedia(image)).rejects.toMatchObject({ code: 'storage_destination_required' });
+  expect(fetchMock).toHaveBeenCalledTimes(1);
+  expect(fetchMock.mock.calls[0][0]).toBe('https://api.tdf.test/storage/me');
+});
+
+it('preserves the retry identity when the transport outcome is unknown', async () => {
+  fetchMock.mockRejectedValue(new TypeError('synthetic-network-details'));
+  await expect(uploadMedia({ ...image, destination: 'tdf', idempotencyKey: 'c'.repeat(64) }))
+    .rejects.toMatchObject({ code: 'storage_outcome_unknown', idempotencyKey: 'c'.repeat(64) });
+});
