    "scheduled": {"booking": "Confirmed", "allocation": "reserved"},
    "in_progress": {"booking": "InProgress", "allocation": "reserved"},
    "balance_due": {"booking": "InProgress", "allocation": "reserved"},
    "completed": {"booking": "Completed", "allocation": "completed"},
    "reschedule_requested": {"booking": "Confirmed", "allocation": "reserved"},
    "cancellation_requested": {"booking": "Confirmed", "allocation": "reserved"},
    "cancelled": {"booking": "Cancelled", "allocation": "released"},
    "no_show": {"booking": "NoShow", "allocation": "reserved"},
    "overtime_review": {"booking": "InProgress", "allocation": "reserved"},
