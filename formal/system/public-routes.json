{
 "schemaVersion": 1,
 "requirement": "AUTH-PUBLIC-001",
 "authority": "Reviewed register of every compiled route served without a Servant AuthProtect combinator and the boundary that admits it. Admission is checked against compiled-api-surface.json, which CI separately proves matches the built executable. A registered boundary is a reviewed claim about the handler, not proof of its implementation.",
 "boundaries": {
  "public-read": {
   "mutating": false,
   "rule": "Anonymous read of content intended for public display. Must not return private, staff-only or per-person data."
  },
  "public-diagnostic": {
   "mutating": false,
   "mutatingPaths": [
    "/mcp"
   ],
   "rule": "Service identity/health/contract only. /mcp is JSON-RPC over POST and exposes only tdf_health_check."
  },
  "capability-header": {
   "mutating": true,
   "requiresHeader": true,
   "rule": "Handler must verify the named server-issued lookup secret (stored as a hash, compared in constant time) before reading or changing the resource."
  },
  "capability-path": {
   "mutating": true,
   "rule": "Path identifier is a server-generated random UUIDv4 bearer capability; sequential or user-chosen identifiers are not admissible."
  },
  "signed-provider-callback": {
   "mutating": true,
   "rawBody": true,
   "rule": "Handler authenticates the exact request body against the provider signature or provider query-back before any effect (ADR-0101, ADR-0118, AUTH-WEBHOOK-001)."
  },
  "provider-verification-challenge": {
   "mutating": false,
   "requiresQuery": "hub.verify_token",
   "rule": "Meta subscription challenge; echoes hub.challenge only when the configured verify token matches."
  },
  "handler-session": {
   "mutating": true,
   "requiresAnyHeader": [
    "Authorization",
    "Cookie"
   ],
   "rule": "Handler resolves the session from the Authorization or Cookie header itself and rejects missing, expired or revoked sessions."
  },
  "credential-intake": {
   "mutating": true,
   "rule": "Login, signup and password-reset intake. Must not disclose account existence beyond the documented identity contract."
  },
  "public-intake": {
   "mutating": true,
   "rule": "Anonymous creation of a new record owned by the submitter (lead, order, registration, cart). Must not read or modify existing records of other parties; follow-up access uses a capability-header or capability-path boundary."
  },
  "operator-secret": {
   "mutating": true,
   "requiresHeader": true,
   "rule": "Requires the configured operator seed secret; disabled when unset."
  },
  "known-debt": {
   "mutating": true,
   "requiresDebt": true,
   "rule": "Reviewed and found insufficient. Kept visible until repaired; never counted as conformant."
  },
  "public-static-files": {
   "mutating": false,
   "raw": true,
   "rule": "Opaque Raw mount serving static files (GET/HEAD) from the public media root. Private stores must reside outside that root (settlement evidence is refused inside it) or in an excluded path (.internal-feedback). A Raw mount accepts every method, so only raw-capable boundaries may register one."
  }
 },
 "debt": {
  "DEBT-AUTH-ACADEMY-001": {
   "priority": "P2",
   "summary": "Academy enroll/progress and referral claim identify the actor only by a submitted email. Anyone can create or alter enrollment, progress and referral attribution for any email, and the progress 404 discloses whether an email is enrolled."
  },
  "DEBT-PRIV-WHATSAPP-001": {
   "priority": "P2",
   "summary": "Public WhatsApp consent records consent for any phone number without proof of control and immediately sends a WhatsApp message to it; the public GET discloses consent state and timestamps for any number; anyone can opt any number out."
  }
 },
