From 88d583f32bd6ac398dc0c2d7d36ac310568acf3b Mon Sep 17 00:00:00 2001
From: MacPro <macpro@MacPros-Mac-Pro.localdomain>
Date: Wed, 28 Oct 2026 21:33:48 -0500
Subject: [PATCH] chore(api): expose optional public review profile identities

---
 src/api/generated/types.ts | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/src/api/generated/types.ts b/src/api/generated/types.ts
index fd7a719..9451343 100644
--- a/src/api/generated/types.ts
+++ b/src/api/generated/types.ts
@@ -9712,8 +9712,13 @@ export interface components {
             verifiedPurchase: true;
             /** @enum {string} */
             badge: "Compra verificada";
-            /** @description Public name/avatar according to buyer privacy preferences */
+            /** @description Public identity according to buyer privacy preferences; partyId and avatarUrl are omitted for anonymous buyers */
             author: {
+                /** Format: int64 */
+                partyId?: number;
+                name?: string;
+                avatarUrl?: string | null;
+            } & {
                 [key: string]: unknown;
             };
             dimensions: {
@@ -16357,6 +16362,8 @@ export interface components {
         /** @enum {string} */
         ExperienceReviewSourceKind: "event_ticket_order" | "marketplace_order" | "service_booking" | "service_storefront_order";
         ExperienceReviewAuthor: {
+            /** Format: int64 */
+            partyId?: number;
             name: string;
             /** Format: uri */
             avatarUrl?: string | null;
-- 
