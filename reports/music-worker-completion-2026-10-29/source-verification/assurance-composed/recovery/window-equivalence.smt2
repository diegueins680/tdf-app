(set-option :timeout 30000)
(set-logic QF_BV)
(declare-fun issued () (_ BitVec 64))
(declare-fun current () (_ BitVec 64))
(declare-fun expires () (_ BitVec 64))
(assert (let ((a!1 (and (bvsle #x0000000000000000 issued)
                (bvsle issued current)
                (bvslt current expires)
                (= #b00000000000000000000000000000000000000000000000000000001110000100
                   (bvsub ((_ sign_extend 1) expires)
                          ((_ sign_extend 1) issued)))))
      (a!2 (and (bvsge issued #x0000000000000000)
                (= ((_ sign_extend 1) expires)
                   (bvadd ((_ sign_extend 1) issued)
                          #b00000000000000000000000000000000000000000000000000000001110000100))
                (bvsge ((_ sign_extend 1) current) ((_ sign_extend 1) issued))
                (bvslt ((_ sign_extend 1) current)
                       (bvadd ((_ sign_extend 1) issued)
                              #b00000000000000000000000000000000000000000000000000000001110000100)))))
  (distinct a!1 a!2)))

(check-sat)
