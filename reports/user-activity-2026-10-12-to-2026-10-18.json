  "definitions": {
    "observed_active_users": "Distinct actor/party identifiers across successful authentication/account creation and persisted engagement, messaging, follows, RSVP, interaction, profile creation, event creation, fan-club and favorite records in the specified period; excludes CRM-only party creation and actorless bookings/orders. This is observed activity, not complete visitor or session analytics.",
    "new_accounts": "Distinct auth account_consent_recorded/signup actors, reconciled to signup_completed_at in user_onboarding_progress. Google initial logins overlap with signup; events are not added as separate users.",
    "onboarding": "Signup cohort members with completed_at before their respective cohort week end.",
    "first_value": "Signup cohort members with first_value_completed_at before their respective cohort week end.",
    "staff": "Active current admin/reception/intern role membership; historical role membership at event time was not reconstructed.",
    "status": "Booking and order statuses are current at query time, not reconstructed as of the reporting cutoff."
  },
  "limitations": [
    "Anonymous visitors, page views, session duration, device split and listening time were not measured by these queries.",
    "Persisted rows can omit deleted records and uninstrumented actions. Zero records means no activity observed in these sources.",
    "Staff activity is included in the overall total and separately quantified.",
    "CRM parties and auto-created fan profiles are not counted as additional new users.",
    "Follow rows and their engagement log records describe the same actions and must not be summed.",
    "Three tentative booking records have no recorded creator; self-service origin is unverified."
  ],
