  "problem": "createPurchase discarded positive product validity and always persisted no expiry. The existing manual promises validity/expiry and the seed configures120days. Nonpositive handling was ambiguous until the owner explicitly selected refusal.",
  "ownerDecisions": [
    "Positive validity: exact stored purchasedAt plus n*86400 elapsed seconds.",
    "Refuse zero/negative configured validity; absent value remains nonexpiring."
  ],
  "correction": "Snapshot expiry on new purchases and refuse invalid configured validity with409 before insertion, after existing reference/inactive checks. Two production edits only; no historical record rewrite.",
  "properties": [
    {
      "id": "PKG-PURCHASE-EXPIRY-001/POSITIVE",
      "status": "TESTED",
      "statement": "A successful positive-term purchase has expiry exactly n elapsed days from its persisted purchasedAt.",
      "bounds": "Actual1/120/365day Handler/SQLite fixtures; timestamp must fit database representation."
    },
    {
      "id": "PKG-PURCHASE-EXPIRY-001/INVALID",
      "status": "TESTED",
      "statement": "Zero/negative configured terms refuse409 with no persisted row.",
      "bounds": "Actual0/-1fixtures; late-refusal source fault commits a row and is detected."
    },
    {
      "id": "PKG-PURCHASE-EXPIRY-001/COMPATIBILITY",
      "status": "TESTED",
      "statement": "Absent expiry, purchase fields and existing module/reference/inactive refusals remain.",
      "bounds": "Finite actual Handler/SQLite fixtures and exact two-edit source reversal; no authenticatedHTTP proof."
    }
  ],
