(set-option :timeout 30000)
(set-logic QF_BV)
(declare-fun limit () (_ BitVec 64))
(declare-fun amount () (_ BitVec 64))
(declare-fun current () (_ BitVec 64))
(assert (let ((a!1 (and (= ((_ sign_extend 1) (bvadd current amount))
                   (bvadd ((_ sign_extend 1) current)
                          ((_ sign_extend 1) amount)))
                (bvsgt (bvadd current amount) current)
                (bvsle (bvadd current amount) limit))))
  (and (bvsge current #x0000000000000000)
       (bvsge limit #x0000000000000000)
       (not (bvsge #x0000000000000000 amount))
       (not (bvsgt amount (bvsub limit current)))
       (not a!1))))

(check-sat)
