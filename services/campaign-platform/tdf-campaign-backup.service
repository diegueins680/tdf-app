[Unit]
Description=TDF campaign database and asset manifest backup
[Service]
Type=oneshot
User=tdf-campaign
Group=tdf-campaign
Environment=CAMPAIGN_CONFIG=/etc/tdf-campaign-platform/config.json
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/tdf-campaign-platform/venv/bin/python /opt/tdf-campaign-platform/current/backup.py
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tdf-campaign-platform
MemoryMax=160M
Nice=15
CPUQuota=40%
TimeoutStartSec=6h
