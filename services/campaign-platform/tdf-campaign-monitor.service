[Unit]
Description=TDF campaign independent executor monitor
[Service]
Type=oneshot
User=tdf-campaign
Group=tdf-campaign
Environment=CAMPAIGN_CONFIG=/etc/tdf-campaign-platform/config.json
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/tdf-campaign-platform/venv/bin/python /opt/tdf-campaign-platform/current/monitor.py
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tdf-campaign-platform
MemoryMax=120M
