[Unit]
Description=TDF music campaign API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tdf-campaign
Group=tdf-campaign
WorkingDirectory=/opt/tdf-campaign-platform/current
Environment=CAMPAIGN_CONFIG=/etc/tdf-campaign-platform/config.json
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/tdf-campaign-platform/venv/bin/python /opt/tdf-campaign-platform/current/server.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tdf-campaign-platform
MemoryMax=320M
CPUQuota=60%
TasksMax=64
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
