{
  "ideaCommand": "node {tool_root}/scripts/discover-improvement-idea.mjs",
  "implementationCommand": "{tool_root}/scripts/codex-loop-worker.sh implement {idea_file}",
  "logicalFixCommand": "{tool_root}/scripts/codex-loop-worker.sh logical-fix {logical_report_file}",
  "formalFixCommand": "{tool_root}/scripts/codex-loop-worker.sh formal-fix {formal_report_file}",
  "uxFixCommand": "{tool_root}/scripts/codex-loop-worker.sh ux-fix {ux_report_file}",
  "uiFixCommand": "{tool_root}/scripts/codex-loop-worker.sh ui-fix {ui_report_file}",
  "ciRepairCommand": "{tool_root}/scripts/codex-loop-worker.sh ci-repair {ci_report_file}",
  "verifyCommand": "node {tool_root}/scripts/continuous-improvement-loop-verify.mjs",
  "commitMessageTemplate": "{commit_message}",
  "pushRemote": "origin",
  "baseBranch": "main",
  "branchPrefix": "continuous-improvement-loop/",
  "checkoutSubmodules": true,
  "traceabilityFile": "formal/system/traceability.json",
  "openPullRequest": true,
  "draftPullRequest": true,
  "maxOpenPullRequests": 3,
  "prBacklogDelaySeconds": 900,
  "pollGitHub": false,
  "pollIntervalSeconds": 30,
  "ciTimeoutMinutes": 45,
  "stepTimeoutMinutes": 180,
  "stopOnNoChanges": false,
  "iterationDelaySeconds": 20
}
